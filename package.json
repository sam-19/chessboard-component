{
  "name": "@sam-19/chessboard-component",
  "version": "1.0.0",
  "description": "A <chess-board> web component built with Lit.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sam-19/chessboard-component.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE.md",
    "README.md"
  ],
  "sideEffects": [
    "./dist/index.js",
    "./dist/chessboard.js"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "npm run build",
    "release": "npm publish --access=public"
  },
  "dependencies": {
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@vitest/browser-playwright": "^5.0.5",
    "eslint": "^10.0.0",
    "eslint-plugin-lit": "^2.3.1",
    "playwright": "^1.64.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
